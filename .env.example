# Copy this file to .env and fill in your own values.
# Never commit .env.

# Django
# Generate a key with:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# The address the "Mark as applied" links in the digest email start with.
SITE_URL=http://127.0.0.1:8000

# PostgreSQL (used by compose.yaml)
POSTGRES_DB=job_search_tracker
POSTGRES_USER=job_search_tracker
POSTGRES_PASSWORD=change-me

# Must use the same user, password, and database name as above.
# compose.yaml maps PostgreSQL to port 5433 on your computer.
DATABASE_URL=postgres://job_search_tracker:change-me@localhost:5433/job_search_tracker

# Job sources that need a key. Leave blank to skip that source.
# JSearch: your RapidAPI application key.
RAPIDAPI_KEY=
# TheirStack: your API key.
THEIRSTACK_API_KEY=

# True keeps jobs that call a degree "a plus" or "nice to have".
# False rejects any job that mentions a degree.
ALLOW_DEGREE_A_PLUS=True

# DEBUG also logs every rejected job and the reason.
LOG_LEVEL=INFO

# Daily digest email (send_digest), sent through Gmail.
# EMAIL_HOST_USER is the Gmail account that sends the email.
# EMAIL_HOST_PASSWORD is a Gmail app password (16 letters, no spaces),
# not the account's login password. It needs 2-Step Verification turned on.
EMAIL_HOST_USER=you@gmail.com
EMAIL_HOST_PASSWORD=
# The inbox that gets the daily digest.
DIGEST_TO=you@gmail.com